# MIR is compiled through two wrapper files that include its sources
# (zumir_mir.h decides whether it is compiled at all), so the vendored tree
# under vendor/mir/ is never compiled on its own.
#
# zumir-win.def exports R_init_zumir alone. $(C_VISIBILITY) is empty here
# on most toolchains. ZUMIR_NO_MIR=1 in the environment builds without MIR,
# as on a CPU MIR does not target (tests/testthat/test-no-target.R).
PKG_CPPFLAGS = $(ZUMIR_NO_MIR:1=-DZUMIR_NO_MIR)
PKG_CFLAGS = $(C_VISIBILITY)
# pthreads for the thread tests (src/zumir_test_models.c).
PKG_LIBS = -lpthread
OBJECTS = zumir.o zumir_mir.o zumir_mir_gen.o zumir_mir_stdio.o zumir_mir_glue.o zumir_trap.o zumir_ctx.o zumir_probe.o zumir_test_sink.o zumir_test_trap.o zumir_test_models.o zumir_test_wx.o
